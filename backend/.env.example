PORT=3000
DATABASE_URL=postgres://zaraa:zaraa@localhost:5432/zaraa_party
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Akun Developer pertama (dibuat oleh: npm run seed)
DEV_USERNAME=root
DEV_PASSWORD=root

# Voice real-time (LiveKit). Boleh dikosongkan saat pengembangan awal.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Alamat publik server (dipakai untuk URL file unggahan). Kosongkan untuk pakai host permintaan.
PUBLIC_URL=

# Pembayaran top-up koin (Midtrans Snap). Kunci sandbox ada di dashboard.midtrans.com.
# Atur "Payment Notification URL" di dashboard Midtrans ke: https://DOMAINMU/api/topup/notify
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Login Google: Client ID tipe "Web" dari Google Cloud Console (boleh beberapa, pisahkan dengan koma).
GOOGLE_CLIENT_ID=

# Email kontak yang tampil di halaman /privacy dan /hapus-akun.
CONTACT_EMAIL=
